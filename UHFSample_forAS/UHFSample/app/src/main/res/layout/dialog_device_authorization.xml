<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="22dp">

    <!-- Header with Warning Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Device Security"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/navy_primary" />

        <TextView
            android:id="@+id/dialog_auth_tv_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UNAUTHORIZED"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/status_red"
            android:background="@drawable/bg_badge_awaiting"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CipherLab RS38 Hardware Access Control"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="16dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_color"
        android:layout_marginBottom="16dp" />

    <!-- Info Container Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/gray_100"
        android:padding="14dp"
        android:layout_marginBottom="16dp">

        <!-- MAC Address -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEVICE MAC ADDRESS"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.05"
            android:layout_marginBottom="3dp" />

        <TextView
            android:id="@+id/dialog_auth_tv_mac"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:1F:B5:7C:10:01"
            android:textSize="16sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:textColor="@color/navy_primary"
            android:layout_marginBottom="12dp" />

        <!-- Detected Model -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DETECTED HARDWARE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.05"
            android:layout_marginBottom="3dp" />

        <TextView
            android:id="@+id/dialog_auth_tv_model"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CipherLab RS38 UHF RFID / 2D Reader"
            android:textSize="13sp"
            android:textColor="@color/black"
            android:layout_marginBottom="12dp" />

        <!-- Status Details -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SERVER STATUS &amp; REASON"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:letterSpacing="0.05"
            android:layout_marginBottom="3dp" />

        <TextView
            android:id="@+id/dialog_auth_tv_reason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Device MAC address is not authorized in Enterprise Device Management."
            android:textSize="12sp"
            android:textColor="@color/status_red" />
    </LinearLayout>

    <!-- Advisory Text -->
    <TextView
        android:id="@+id/dialog_auth_tv_advisory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="To connect to production lines and commit WIP transactions, this scanner must be authorized. You can click 'Authorize Device' below to register it immediately with the backend server."
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="18dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Primary Action: Authorize / Register -->
        <Button
            android:id="@+id/dialog_auth_btn_authorize"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="✓ Authorize Device Now"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/bg_btn_primary"
            android:layout_marginBottom="8dp" />

        <!-- Secondary Action: Retry Check -->
        <Button
            android:id="@+id/dialog_auth_btn_retry"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="⟳ Retry Authorization Check"
            android:textSize="13sp"
            android:textColor="@color/navy_primary"
            android:background="@drawable/bg_btn_secondary"
            android:layout_marginBottom="8dp" />

        <!-- Tertiary Action: Dismiss / Continue Offline -->
        <Button
            android:id="@+id/dialog_auth_btn_dismiss"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="Dismiss / Continue Offline"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:background="@android:color/transparent" />
    </LinearLayout>

</LinearLayout>

