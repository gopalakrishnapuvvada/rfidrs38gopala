<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    tools:context=".MainActivity">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CipherLab RS38 - Dual Scanner"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1976D2"
        android:gravity="center"
        android:layout_marginBottom="4dp" />

    <!-- Service Connection Status -->
    <TextView
        android:id="@+id/tv_service_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RFID: Connecting... | 2D Barcode: Ready"
        android:textSize="12sp"
        android:textColor="#666666"
        android:layout_marginBottom="6dp" />

    <!-- Server Configuration Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/edt_server_url"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="http://127.0.0.1:8000/post_fixed_rfid"
            android:inputType="textUri"
            android:textSize="12sp"
            android:maxLines="1" />

        <Button
            android:id="@+id/btn_save_url"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Card 1: Last Scanned RFID Tag -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#EEEEEE"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏷️ Last Scanned RFID Tag"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="#D32F2F"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tv_epc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EPC: (None)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:fontFamily="monospace" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_tid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TID: -"
                android:textSize="11sp"
                android:textColor="#555555"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tv_rssi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RSSI: - dBm"
                android:textSize="11sp"
                android:textColor="#555555" />
        </LinearLayout>
    </LinearLayout>

    <!-- Card 2: Last Scanned QR Code -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="#E3F2FD"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📱 Last Scanned QR Code / Barcode"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="#1565C0"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tv_qr_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Data: (None)"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#0D47A1"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tv_qr_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Ready for 2D barcode scan"
            android:textSize="11sp"
            android:textColor="#555555"
            android:layout_marginBottom="4dp" />

        <!-- Dedicated QR input box for direct capture & keyboard wedge -->
        <EditText
            android:id="@+id/edt_qr_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Or aim &amp; press RS38 side scan key..."
            android:textSize="11sp"
            android:singleLine="true"
            android:background="#FFFFFF"
            android:padding="6dp" />
    </LinearLayout>

    <!-- API Response Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp"
        android:background="#E8F5E9"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tv_api_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="API Status: Idle (Ready)"
            android:textSize="12sp"
            android:textColor="#2E7D32"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <Button
            android:id="@+id/btn_trigger_rfid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Scan RFID"
            android:textSize="12sp"
            android:layout_marginEnd="3dp" />

        <Button
            android:id="@+id/btn_trigger_qr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Scan QR"
            android:textSize="12sp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp" />

        <Button
            android:id="@+id/btn_clear_log"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:text="Clear"
            android:textSize="12sp"
            android:layout_marginStart="3dp" />
    </LinearLayout>

    <!-- Activity Log Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Live Transmission Log:"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp" />

    <!-- Scrollable Log Output -->
    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FAFAFA"
        android:padding="6dp">

        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dual scanner ready.\n"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textColor="#424242" />
    </ScrollView>

</LinearLayout>
